# Export these in your shell; the API never sends credentials to the browser.
# Set only backends you explicitly want. No real secrets here.
# XTTS_PYTHON=/absolute/path/to/existing/xtts_project/venv/bin/python
# MLX_PYTHON=/absolute/path/to/separate/mlx-env/bin/python
# MLX_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-bf16
# MLX_REFERENCE_TEXT=transcript-of-the-authorized-reference
# WHISPER_PYTHON=/absolute/path/to/separate/whisper-env/bin/python
# WHISPER_MODEL=base
# LOCAL_LLM_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_MODEL=your-loaded-model
# OPENAI_API_KEY=set-locally
# OPENAI_MODEL=set-an-available-text-model
